/* app.wxss 全局样式 */
page {
  background: #f5f6f8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f1f1f;
  box-sizing: border-box;
}

view, text, button, scroll-view, canvas, image {
  box-sizing: border-box;
}

.page {
  padding: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1;
}

.btn-primary {
  background: #ff7a45;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #333;
  border: 1rpx solid #e2e4e8;
}

.btn-block {
  width: 100%;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f1f3;
  color: #555;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* 无障碍：大字体 / 高对比 */
.a11y-lg { font-size: 30rpx; }
.a11y-lg .title { font-size: 38rpx; }
.a11y-lg .muted { font-size: 27rpx; }
.a11y-lg .btn { height: 96rpx; font-size: 32rpx; }
.a11y-hc { filter: contrast(1.25); }
.a11y-hc .card {
  background: #fff;
  border: 2rpx solid #111;
  box-shadow: none;
}
.a11y-hc .muted { color: #555; }
.a11y-hc .btn-ghost { border-color: #111; color: #111; }
.a11y-hc .title, .a11y-hc .iname { color: #000; }
