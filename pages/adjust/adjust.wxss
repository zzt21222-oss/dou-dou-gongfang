.canvas-wrap {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #f0f1f3;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-canvas {
  width: 100%;
  height: 600rpx;
}
.mini {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  margin-left: 12rpx;
  border-radius: 12rpx;
}
.slider-row {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}
.slider-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #555;
}
.slider {
  flex: 1;
}
.row.wrap {
  flex-wrap: wrap;
}
.ratio-row {
  margin-top: 12rpx;
}
.ratio-item {
  padding: 10rpx 24rpx;
  background: #f0f1f3;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
  color: #555;
}
.ratio-item.active {
  background: #ff7a45;
  color: #fff;
}
.mask-canvas {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 600rpx;
  opacity: 0;
  pointer-events: none;
}
.mask-canvas.show {
  opacity: 1;
  pointer-events: auto;
}
.btn-accent {
  background: #ff7a45 !important;
  color: #fff !important;
}
